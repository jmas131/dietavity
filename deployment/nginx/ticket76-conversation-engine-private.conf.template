# Sanitized structural representation of the production Ticket 76 private
# Conversation Engine listener. It contains no credential value: the existing
# incoming header is passed through to the loopback Express upstream.
#
# Do not apply this file directly. Keep it included from nginx's `http` context
# and use the deployment notes in ../TICKET-89-NGINX-BASELINE.md.
server {
    listen 172.18.0.1:12751;
    server_name _;

    client_max_body_size 16k;

    location = /internal/conversation-engine/v1/resolve {
        limit_except POST {
            deny all;
        }

        allow 172.18.0.2;
        deny all;

        proxy_pass http://127.0.0.1:3000/internal/conversation-engine/v1/resolve;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header x-dietavity-conversation-engine-secret $http_x_dietavity_conversation_engine_secret;

        proxy_connect_timeout 5s;
        proxy_send_timeout 25s;
        proxy_read_timeout 25s;
    }

    location = /internal/conversation-engine/v4/resolve {
        limit_except POST {
            deny all;
        }

        allow 172.18.0.2;
        deny all;

        proxy_pass http://127.0.0.1:3000/internal/conversation-engine/v4/resolve;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header x-dietavity-conversation-engine-secret $http_x_dietavity_conversation_engine_secret;

        proxy_connect_timeout 5s;
        proxy_send_timeout 25s;
        proxy_read_timeout 25s;
    }

    location / {
        return 404;
    }
}
