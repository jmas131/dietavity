# Sandbox-only private listener. It must be installed separately from the
# production Ticket 76 listener and never share its bridge or upstream port.
server {
    listen 172.19.0.1:12751;
    server_name _;

    client_max_body_size 16k;

    location = /internal/conversation-engine/v1/resolve {
        limit_except POST { deny all; }
        allow 172.19.0.2;
        deny all;
        proxy_pass http://127.0.0.1:3101/internal/conversation-engine/v1/resolve;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header x-dietavity-conversation-engine-secret $http_x_dietavity_conversation_engine_secret;
        proxy_connect_timeout 5s;
        proxy_send_timeout 25s;
        proxy_read_timeout 25s;
    }

    location = /internal/conversation-engine/v4/resolve {
        limit_except POST { deny all; }
        allow 172.19.0.2;
        deny all;
        proxy_pass http://127.0.0.1:3101/internal/conversation-engine/v4/resolve;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header x-dietavity-conversation-engine-secret $http_x_dietavity_conversation_engine_secret;
        proxy_connect_timeout 5s;
        proxy_send_timeout 25s;
        proxy_read_timeout 25s;
    }

    location = /internal/media-enrichment/v1/resolve {
        limit_except POST { deny all; }
        allow 172.19.0.2;
        deny all;
        proxy_pass http://127.0.0.1:3101/internal/media-enrichment/v1/resolve;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header x-dietavity-conversation-engine-secret $http_x_dietavity_conversation_engine_secret;
        proxy_connect_timeout 5s;
        proxy_send_timeout 25s;
        proxy_read_timeout 35s;
    }

    location / { return 404; }
}
