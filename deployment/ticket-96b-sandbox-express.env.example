# Copy outside the repository with mode 0600. This is for a separate sandbox
# Express process; it must not inherit the production PM2 environment.
NODE_ENV=production
DIETAVITY_LISTENER_HOST=127.0.0.1
DIETAVITY_LISTENER_PORT=3101
SUPABASE_URL=REPLACE_WITH_SANDBOX_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SANDBOX_SERVICE_ROLE_KEY
OPENAI_API_KEY=REPLACE_WITH_SANDBOX_LIMITED_KEY
TWILIO_MEDIA_API_KEY=REPLACE_WITH_SANDBOX_MEDIA_API_KEY
TWILIO_MEDIA_API_SECRET=REPLACE_WITH_SANDBOX_MEDIA_API_SECRET
DIETAVITY_CONVERSATION_ENGINE_SECRET=REPLACE_WITH_NEW_SANDBOX_SHARED_SECRET
DIETAVITY_MEDIA_IMAGES_ENABLED=false
DIETAVITY_MEDIA_AUDIO_ENABLED=false
MEDIA_VISION_MODEL=gpt-4.1-mini
MEDIA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
