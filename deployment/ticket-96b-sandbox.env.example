# Copy outside the repository with mode 0600. Replace every placeholder only
# with sandbox-specific values; never source a production environment file.
N8N_SANDBOX_HOST=sandbox-n8n.example.invalid
N8N_SANDBOX_WEBHOOK_URL=https://sandbox-n8n.example.invalid/
N8N_SANDBOX_ENCRYPTION_KEY=REPLACE_WITH_A_NEW_RANDOM_SANDBOX_SECRET
# Exact Ticket 96B n8n $env allowlist. Values must all identify sandbox/test
# resources; no other production environment file may be sourced.
SANDBOX_OPENAI_API_KEY=REPLACE_WITH_SANDBOX_LIMITED_KEY
SANDBOX_STRIPE_TEST_API_KEY=REPLACE_WITH_STRIPE_TEST_KEY
SANDBOX_TWILIO_ACCOUNT_SID=REPLACE_WITH_SANDBOX_TWILIO_ACCOUNT_SID
SANDBOX_TWILIO_MESSAGING_SERVICE_SID=REPLACE_WITH_SANDBOX_MESSAGING_SERVICE_SID
SANDBOX_TWILIO_SALES_REMINDER_CONTENT_SID=REPLACE_WITH_SANDBOX_TEMPLATE_SID
SANDBOX_TWILIO_SALES_REMINDER_CANONICAL_BODY=REPLACE_WITH_APPROVED_SANDBOX_TEMPLATE_BODY
