{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dietavity.local/contracts/sales-engine-v2-contract.schema.json",
  "title": "Dietavity Sales Engine v2 contracts",
  "type": "object",
  "description": "Boundary contracts proposed by Ticket 57. This schema does not authorize actions or define a database schema.",
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object", "required": ["type", "id", "version"], "additionalProperties": false,
      "description": "Explicit provenance. Generated material is deliberately not a fact, policy, reviewed-knowledge, or system source.",
      "properties": {
        "type": {"enum":["canonical_fact","deterministic_policy","reviewed_knowledge","generated_guidance","conversational_generation","system"]},
        "id": {"type":"string","minLength":1}, "version": {"type":"string","minLength":1},
        "model_run_id": {"type":"string","minLength":1}, "generation_stage": {"enum":["bounded_reasoning","composer"]}
      },
      "allOf": [
        {"if":{"properties":{"type":{"const":"generated_guidance"}}},"then":{"required":["model_run_id","generation_stage"],"properties":{"generation_stage":{"const":"bounded_reasoning"}}}},
        {"if":{"properties":{"type":{"const":"conversational_generation"}}},"then":{"required":["model_run_id","generation_stage"],"properties":{"generation_stage":{"const":"composer"}}}},
        {"if":{"properties":{"type":{"enum":["canonical_fact","deterministic_policy","reviewed_knowledge","system"]}}},"then":{"not":{"anyOf":[{"required":["model_run_id"]},{"required":["generation_stage"]}]}}}
      ]
    },
    "conversationArtifact": {
      "description":"Prospective non-authoritative conversational metadata; its message text is transformable data, never a truth or delivery source.",
      "type":"object","required":["contract_version","artifact_id","artifact_type","generation_operation","generation_task_id","logical_reply_key","anchor_message_id"],"additionalProperties":false,
      "properties":{
        "contract_version":{"const":"1.0"},"artifact_id":{"type":"string","pattern":"^ca-[A-Za-z0-9._-]+$"},
        "artifact_type":{"enum":["draft","summary"]},"generation_operation":{"enum":["draft","transform","summarize"]},"generation_task_id":{"type":"string","pattern":"^cgt-[A-Za-z0-9._-]+$"},
        "logical_reply_key":{"type":"string","minLength":1},"anchor_message_id":{"type":"string","format":"uuid"}
      },
      "allOf":[
        {"if":{"properties":{"generation_operation":{"const":"summarize"}}},"then":{"properties":{"artifact_type":{"const":"summary"}}}},
        {"if":{"properties":{"generation_operation":{"enum":["draft","transform"]}}},"then":{"properties":{"artifact_type":{"const":"draft"}}}}
      ]
    },
    "historyMessage": {
      "type": "object", "required": ["role", "text", "occurred_at", "source_id"], "additionalProperties": false,
      "properties": { "role": {"enum":["customer","assistant"]}, "text": {"type":"string"}, "occurred_at": {"$ref":"#/$defs/timestamp"}, "source_id": {"type":"string"}, "final_visible": {"type":"boolean"} }
    },
    "conversationArtifactContext": {
      "description":"Bounded conversational material projected only from Ticket 17A metadata and its canonical outbound logical reply. It is not product truth, policy, safety, authorization, delivery, execution, or factual correctness.",
      "type":"object","required":["artifact_id","artifact_type","generation_operation","generation_task_id","logical_reply_key","anchor_message_id","text","lineage_artifact_ids","occurred_at"],"additionalProperties":false,
      "properties":{
        "artifact_id":{"type":"string","pattern":"^ca-[A-Za-z0-9._-]+$"},"artifact_type":{"enum":["draft","summary"]},"generation_operation":{"enum":["draft","transform","summarize"]},"generation_task_id":{"type":"string","pattern":"^cgt-[A-Za-z0-9._-]+$"},
        "logical_reply_key":{"type":"string","minLength":1},"anchor_message_id":{"type":"string","format":"uuid"},"text":{"type":"string","minLength":1},"lineage_artifact_ids":{"description":"Every ID must reference a sibling retained conversation_artifacts item; executable validation enforces this cross-item membership.","type":"array","items":{"type":"string","pattern":"^ca-[A-Za-z0-9._-]+$"},"uniqueItems":true},"occurred_at":{"$ref":"#/$defs/timestamp"}
      },
      "allOf":[
        {"if":{"properties":{"generation_operation":{"const":"summarize"}}},"then":{"properties":{"artifact_type":{"const":"summary"}}}},
        {"if":{"properties":{"generation_operation":{"enum":["draft","transform"]}}},"then":{"properties":{"artifact_type":{"const":"draft"}}}},
        {"if":{"properties":{"generation_operation":{"const":"draft"}}},"then":{"properties":{"lineage_artifact_ids":{"maxItems":0}}}},
        {"if":{"properties":{"generation_operation":{"enum":["transform","summarize"]}}},"then":{"properties":{"lineage_artifact_ids":{"minItems":1}}}}
      ]
    },
    "boundedInput": {
      "type": "object", "required": ["id","input_type","value","origin"], "additionalProperties": false,
      "properties": {
        "id":{"type":"string","pattern":"^bi-[1-9][0-9]*$"},
        "input_type":{"enum":["meal_name","ingredient","preparation_step","meal_component","schedule_constraint","time_constraint","user_preference"]},
        "value":{"type":"string","minLength":1}, "origin":{"const":"current_turn"}
      }
    },
    "practicalTask": {
      "type":"object", "required":["task_kind","bounded_inputs"], "additionalProperties":false,
      "properties":{"task_kind":{"enum":["knowledge_question","transformation","organization"]},"bounded_inputs":{"type":"array","items":{"$ref":"#/$defs/boundedInput"}}},
      "allOf":[
        {"if":{"properties":{"task_kind":{"enum":["transformation","organization"]}}},"then":{"properties":{"bounded_inputs":{"minItems":1}}}}
      ]
    },
    "conversationalTask": {
      "description":"Bounded conversational-generation selection only; referenced artifact text is not truth, policy, safety, authorization, delivery, or execution evidence. Cross-context artifact membership is enforced by executable validation.",
      "type":"object","required":["operation","artifact_ids","current_turn_constraints","current_turn_inputs"],"additionalProperties":false,
      "properties":{
        "operation":{"enum":["draft","transform","summarize","show"]},
        "artifact_ids":{"type":"array","items":{"type":"string","pattern":"^ca-[A-Za-z0-9._-]+$"},"uniqueItems":true},
        "current_turn_constraints":{"type":"array","items":{"type":"object","required":["value","origin"],"additionalProperties":false,"properties":{"value":{"type":"string","minLength":1},"origin":{"const":"current_turn"}}}},
        "current_turn_inputs":{"type":"array","items":{"type":"object","required":["input_type","value","origin"],"additionalProperties":false,"properties":{"input_type":{"const":"draft_specification"},"value":{"type":"string","minLength":1},"origin":{"const":"current_turn"}}}}
      },
      "allOf":[
        {"if":{"properties":{"operation":{"const":"draft"}}},"then":{"properties":{"artifact_ids":{"maxItems":0},"current_turn_inputs":{"minItems":1}}}},
        {"if":{"properties":{"operation":{"enum":["transform","show"]}}},"then":{"properties":{"artifact_ids":{"minItems":1,"maxItems":1}}}},
        {"if":{"properties":{"operation":{"const":"summarize"}}},"then":{"properties":{"artifact_ids":{"minItems":1}}}}
      ]
    },
    "guidanceUnit": {
      "type":"object", "required":["unit_type","content"], "additionalProperties":false,
      "properties": {
        "unit_type":{"enum":["reviewed_information","practical_instruction","transformation","organization"]},
        "content":{"type":"string","minLength":1},
        "reviewed_knowledge_reference_ids":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
        "bounded_input_ids":{"type":"array","items":{"type":"string","pattern":"^bi-[1-9][0-9]*$"},"minItems":1,"uniqueItems":true}
      },
      "allOf":[
        {"if":{"properties":{"unit_type":{"enum":["reviewed_information","practical_instruction"]}}},"then":{"required":["reviewed_knowledge_reference_ids"],"not":{"required":["bounded_input_ids"]}}},
        {"if":{"properties":{"unit_type":{"enum":["transformation","organization"]}}},"then":{"required":["bounded_input_ids"],"not":{"required":["reviewed_knowledge_reference_ids"]}}}
      ]
    },
    "guidancePayload": {
      "type":"object", "required":["units","semantic_safety_validation_required"], "additionalProperties":false,
      "properties":{"units":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/guidanceUnit"}},"semantic_safety_validation_required":{"const":true}}
    },
    "semanticGuidanceFinding": {
      "type":"object", "required":["code","severity","unit_index","rationale"], "additionalProperties":false,
      "properties":{"code":{"enum":["unsupported_external_fact","product_or_provider_claim","commercial_claim","medication_management","diagnosis_or_prescription","unauthorized_action_claim","bounded_input_semantic_drift","reviewed_knowledge_contradiction","safety_sensitive_guidance","other_semantic_risk"]},"severity":{"enum":["blocking","review_required"]},"unit_index":{"type":"integer","minimum":0},"rationale":{"type":"string","minLength":1}}
    },
    "semanticGuidanceAssessmentSource": {
      "type":"object", "required":["assessment_stage","assessor_run_id","outcome"], "additionalProperties":false,
      "properties":{"assessment_stage":{"const":"semantic_guidance_safety"},"assessor_run_id":{"type":"string","minLength":1},"outcome":{"enum":["completed","unavailable"]},"failure_code":{"const":"SEMANTIC_ASSESSOR_UNAVAILABLE"}},
      "allOf":[{"if":{"properties":{"outcome":{"const":"unavailable"}}},"then":{"required":["failure_code"]}},{"if":{"properties":{"outcome":{"const":"completed"}}},"then":{"not":{"required":["failure_code"]}}}]
    },
    "semanticGuidanceGate": {
      "type":"object", "required":["obligation_id","gate_id","gate_version","gate_status","findings","assessment_source"], "additionalProperties":false,
      "properties":{"obligation_id":{"type":"string","pattern":"^o-[A-Za-z0-9._-]+$"},"gate_id":{"const":"semantic-guidance-safety-gate"},"gate_version":{"const":"ticket-64-v1"},"gate_status":{"enum":["cleared","blocked","indeterminate"]},"findings":{"type":"array","items":{"$ref":"#/$defs/semanticGuidanceFinding"}},"assessment_source":{"$ref":"#/$defs/semanticGuidanceAssessmentSource"}},
      "oneOf":[
        {"title":"completed assessment with no findings clears","properties":{"gate_status":{"const":"cleared"},"findings":{"maxItems":0},"assessment_source":{"properties":{"outcome":{"const":"completed"}}}}},
        {"title":"completed assessment with a blocking finding blocks","properties":{"gate_status":{"const":"blocked"},"findings":{"contains":{"properties":{"severity":{"const":"blocking"}}}},"assessment_source":{"properties":{"outcome":{"const":"completed"}}}}},
        {"title":"completed assessment with review-only findings is indeterminate","properties":{"gate_status":{"const":"indeterminate"},"findings":{"contains":{"properties":{"severity":{"const":"review_required"}}}},"assessment_source":{"properties":{"outcome":{"const":"completed"}}}},"not":{"properties":{"findings":{"contains":{"properties":{"severity":{"const":"blocking"}}}}}}},
        {"title":"unavailable assessment is empty and indeterminate","properties":{"gate_status":{"const":"indeterminate"},"findings":{"maxItems":0},"assessment_source":{"properties":{"outcome":{"const":"unavailable"}}}}}
      ]
    },
    "obligation": {
      "type": "object", "required": ["id","category","current_turn_evidence","confidence","ambiguous"], "additionalProperties": false,
      "properties": {
        "id": {"type":"string","pattern":"^o-[A-Za-z0-9._-]+$"},
        "category": {"enum":["product_fact","provider_service_fact","practical_guidance","conversational_task","commercial_purchase_intent","reminder_request","medication_management","safety_sensitive_nutrition","clarification","support_account","social_acknowledgement"]},
        "subject": {"type":"string"}, "current_turn_evidence": {"type":"string","minLength":1}, "confidence": {"enum":["high","medium","low"]}, "ambiguous": {"type":"boolean"}, "attributes": {"type":"object"}, "practical_task":{"$ref":"#/$defs/practicalTask"}, "conversational_task":{"$ref":"#/$defs/conversationalTask"}, "authorization_subject_version":{"const":"commercial-authorization-subject-v1"}, "authorization_subject_id":{"type":"string","pattern":"^cas-[0-9a-f]{64}$"}
      },
      "allOf":[
        {"if":{"properties":{"category":{"const":"practical_guidance"}}},"then":{"required":["practical_task"]}},
        {"if":{"required":["practical_task"]},"then":{"properties":{"category":{"const":"practical_guidance"}}}},
        {"if":{"properties":{"category":{"const":"conversational_task"}}},"then":{"required":["conversational_task"]}},
        {"if":{"properties":{"category":{"const":"commercial_purchase_intent"}}},"then":{"required":["authorization_subject_version","authorization_subject_id"]}},
        {"if":{"required":["authorization_subject_version"]},"then":{"properties":{"category":{"const":"commercial_purchase_intent"}}}},
        {"if":{"required":["authorization_subject_id"]},"then":{"properties":{"category":{"const":"commercial_purchase_intent"}}}},
        {"if":{"required":["conversational_task"]},"then":{"properties":{"category":{"const":"conversational_task"}}}}
      ]
    },
    "authorizedAction": {
      "type": "object", "required": ["action_type","authorization_source","authorizing_rule","parameters","preconditions","constraints","idempotency","status"], "additionalProperties": false,
      "properties": {
        "action_type": {"enum":["create_checkout","provide_checkout_destination","provide_holding_page_destination","schedule_reminder","persist_commercial_transition","update_conversation_state"]},
        "action_identity_version":{"const":"action-identity-v1"}, "action_id":{"type":"string","pattern":"^act-[0-9a-f]{64}$"},
        "authorization_source": {"const":"deterministic_policy"}, "authorizing_rule": {"type":"string","minLength":1}, "parameters": {"type":"object"}, "preconditions": {"type":"array","items":{"type":"string"}}, "constraints":{"type":"object"},
        "idempotency": {"type":"object","required":["required","key_scope"],"additionalProperties":false,"properties":{"required":{"const":true},"key_scope":{"enum":["inbound_message","session","action"]},"execution_key_version":{"const":"action-execution-idempotency-v1"},"execution_key":{"type":"string","pattern":"^aek-[0-9a-f]{64}$"}}},
        "status": {"const":"authorized"}, "expires_at": {"$ref":"#/$defs/timestamp"}
      },
      "allOf": [
        {"if":{"properties":{"action_type":{"const":"schedule_reminder"}}},"then":{"properties":{"parameters":{"required":["scheduled_for"],"properties":{"scheduled_for":{"$ref":"#/$defs/timestamp"}}}}}}
      ]
    },
    "ActionResult": {
      "description":"Bounded evidence of one attempted authorized-action execution. It is not authorization or delivery evidence and never carries executor internals.",
      "type":"object","required":["action_result_version","action_id","execution_key","action_type","execution_status","provenance","payload"],"additionalProperties":false,
      "properties":{
        "action_result_version":{"const":"ticket-65d-v1"},"action_id":{"type":"string","pattern":"^act-[0-9a-f]{64}$"},"execution_key":{"type":"string","pattern":"^aek-[0-9a-f]{64}$"},
        "action_type":{"enum":["provide_checkout_destination","provide_holding_page_destination"]},"execution_status":{"enum":["succeeded","failed_retryable","failed_terminal"]},
        "provenance":{"type":"object","required":["type","version"],"additionalProperties":false,"properties":{"type":{"const":"authorized_action_execution"},"version":{"const":"ticket-65d-v1"}}},
        "payload":{"type":["object","null"]}
      },
      "allOf":[
        {"if":{"properties":{"execution_status":{"const":"succeeded"}}},"then":{"properties":{"payload":{"type":"object","required":["destination"],"additionalProperties":false,"properties":{"destination":{"type":"object","required":["kind","url"],"additionalProperties":false,"properties":{"kind":{"enum":["checkout","holding_page"]},"url":{"type":"string","format":"uri"}}}}}}}},
        {"if":{"properties":{"execution_status":{"enum":["failed_retryable","failed_terminal"]}}},"then":{"properties":{"payload":{"type":"null"}}}}
      ]
    },
    "PreComposerEnvelope": {
      "description":"Immutable bounded execution-result envelope for a future Composer. It deliberately excludes AuthorizedAction internals, execution keys, raw executor output, and raw workflow state.",
      "type":"object","required":["pre_composer_envelope_version","response_semantics","customer_action_results","action_execution_states"],"additionalProperties":false,
      "properties":{
        "pre_composer_envelope_version":{"const":"ticket-65d-v1"},"response_semantics":{"type":"object","additionalProperties":false,"required":["contract_version","context_id","locale","obligation_ids","required_coverage","canonical_facts","policy_outcomes","permitted_guidance","conversational_generation","commercial_semantics","bounded_uncertainties","clarification_requirements","deferred_obligations","prohibited_claims","prohibited_actions","question_budget","completion_requirement"]},
        "customer_action_results":{"type":"array","items":{"type":"object","required":["action_id","action_type","destination"],"additionalProperties":false,"properties":{"action_id":{"type":"string","pattern":"^act-[0-9a-f]{64}$"},"action_type":{"enum":["provide_checkout_destination","provide_holding_page_destination"]},"destination":{"type":"object","required":["kind","url"],"additionalProperties":false,"properties":{"kind":{"enum":["checkout","holding_page"]},"url":{"type":"string","format":"uri"}}}}}},
        "action_execution_states":{"type":"array","items":{"type":"object","required":["action_id","action_type","execution_status"],"additionalProperties":false,"properties":{"action_id":{"type":"string","pattern":"^act-[0-9a-f]{64}$"},"action_type":{"enum":["provide_checkout_destination","provide_holding_page_destination"]},"execution_status":{"enum":["succeeded","failed_retryable","failed_terminal","in_progress","not_executed"]}}}}
      }
    },
    "resolvedObligation": {
      "type": "object", "required": ["obligation_id","resolution_status","authority","source","allowed_claims","prohibited_claims","customer_uncertainty_required"], "additionalProperties": false,
      "properties": {
        "obligation_id": {"type":"string","pattern":"^o-[A-Za-z0-9._-]+$"}, "resolution_status": {"enum":["resolved","unknown","clarification_required","prohibited","failed","deferred"]},
        "authority": {"type":["string","null"],"enum":["canonical_fact","deterministic_policy","commercial_authorization","reviewed_knowledge","generated_guidance","conversational_generation","bounded_unknown","clarification_required","prohibited","resolver_failure",null]}, "source": {},
        "factual_payload": {}, "policy_decision": {"type":"object"}, "allowed_claims": {"type":"array","items":{"type":"string"}}, "prohibited_claims": {"type":"array","items":{"type":"string"}},
        "retrieved_knowledge_references": {"type":"array","items":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"reviewed_knowledge"}}}]}}, "guidance_payload":{"$ref":"#/$defs/guidancePayload"}, "llm_reasoning_permitted": {"type":"boolean"}, "customer_uncertainty_required": {"type":"boolean"}, "action_authorization": {"$ref":"#/$defs/authorizedAction"}, "next_stage":{"enum":["reviewed_knowledge_or_reasoning","conversational_generation","support_resolution","response_composition"]}
      },
      "allOf": [
        {"if":{"properties":{"authority":{"const":"bounded_unknown"}}},"then":{"properties":{"customer_uncertainty_required":{"const":true}}}},
        {"if":{"properties":{"authority":{"const":"canonical_fact"}}},"then":{"properties":{"source":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"canonical_fact"}}}]}}}},
        {"if":{"properties":{"authority":{"enum":["deterministic_policy","commercial_authorization"]}}},"then":{"properties":{"source":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"deterministic_policy"}}}]}}}},
        {"if":{"properties":{"authority":{"const":"reviewed_knowledge"}}},"then":{"properties":{"source":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"reviewed_knowledge"}}}]}}}},
        {"if":{"properties":{"authority":{"const":"generated_guidance"}}},"then":{"properties":{"source":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"generated_guidance"}}}]}}}},
        {"if":{"properties":{"authority":{"const":"conversational_generation"}}},"then":{"properties":{"source":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"conversational_generation"}}}]}}}},
        {"if":{"properties":{"authority":{"const":"bounded_unknown"}}},"then":{"properties":{"source":{"anyOf":[{"type":"null"},{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"canonical_fact"}}}]}]}}}},
        {"if":{"properties":{"authority":{"const":"clarification_required"}}},"then":{"properties":{"source":{"type":"null"}}}},
        {"if":{"properties":{"authority":{"const":"prohibited"}}},"then":{"properties":{"source":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"deterministic_policy"}}}]}}}},
        {"if":{"properties":{"authority":{"const":"resolver_failure"}}},"then":{"properties":{"source":{"type":"null"}}}},
        {"if":{"properties":{"authority":{"const":"reviewed_knowledge"}}},"then":{"required":["guidance_payload","retrieved_knowledge_references"],"properties":{"resolution_status":{"const":"resolved"},"llm_reasoning_permitted":{"const":false}}}},
        {"if":{"properties":{"authority":{"const":"generated_guidance"}}},"then":{"required":["guidance_payload"],"properties":{"resolution_status":{"const":"resolved"},"llm_reasoning_permitted":{"const":true}}}},
        {"if":{"properties":{"resolution_status":{"const":"deferred"}}},"then":{"required":["next_stage","llm_reasoning_permitted"],"properties":{"authority":{"const":null},"source":{"type":"null"},"allowed_claims":{"maxItems":0},"prohibited_claims":{"maxItems":0},"customer_uncertainty_required":{"const":false},"llm_reasoning_permitted":{"const":false}},"not":{"anyOf":[{"required":["factual_payload"]},{"required":["policy_decision"]},{"required":["action_authorization"]},{"required":["retrieved_knowledge_references"]},{"required":["guidance_payload"]}]}}},
        {"if":{"properties":{"authority":{"const":null}}},"then":{"properties":{"resolution_status":{"const":"deferred"}}}},
        {"if":{"required":["next_stage"]},"then":{"properties":{"resolution_status":{"const":"deferred"}}}},
        {"if":{"properties":{"authority":{"enum":["canonical_fact","deterministic_policy","commercial_authorization","bounded_unknown","clarification_required","prohibited","resolver_failure"]}}},"then":{"properties":{"llm_reasoning_permitted":{"const":false}}}}
      ]
    },
    "retrievedKnowledge": {
      "type": "object", "required": ["source","review_status","domain","retrieved_reference"], "additionalProperties": false,
      "properties": {"source":{"allOf":[{"$ref":"#/$defs/source"},{"properties":{"type":{"const":"reviewed_knowledge"}}}]},"review_status":{"enum":["approved","rejected","expired"]},"domain":{"enum":["nutrition_education","glp1_nutrition","recipe","ingredient_substitution","meal_preparation","faq"]},"retrieved_reference":{"type":"string"},"excerpt":{"type":"string"},"relevance":{"type":"number","minimum":0,"maximum":1},"effective_from":{"$ref":"#/$defs/timestamp"},"reviewed_at":{"$ref":"#/$defs/timestamp"}}
    }
  },
  "properties": {
    "ConversationContext": {
      "type": "object", "required": ["contract_version","context_id","locale","current_message","history","history_metadata","conversation_artifacts","conversation_artifacts_metadata","session_state","offer_context","customer_state","commercial_state","metadata","authoritative_context","informational_context"], "additionalProperties": false,
      "properties": {
        "contract_version":{"const":"2.0"},"context_id":{"type":"string"},"locale":{"const":"es-MX"},
        "current_message":{"type":"object","required":["role","text","occurred_at","source_id","canonical_message_id"],"additionalProperties":false,"properties":{"role":{"const":"customer"},"text":{"type":"string","minLength":1},"occurred_at":{"$ref":"#/$defs/timestamp"},"source_id":{"type":"string","minLength":1},"canonical_message_id":{"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"}}},"history":{"type":"array","items":{"$ref":"#/$defs/historyMessage"}},
        "history_metadata":{"type":"object","required":["ordering","history_truncated","retained_prior_turns","retained_prior_characters"],"additionalProperties":false,"properties":{"ordering":{"const":"occurred_at"},"history_truncated":{"type":"boolean"},"retained_prior_turns":{"type":"integer","minimum":0},"retained_prior_characters":{"type":"integer","minimum":0}}},
        "conversation_artifacts":{"type":"array","items":{"$ref":"#/$defs/conversationArtifactContext"}},
        "conversation_artifacts_metadata":{"type":"object","required":["ordering","artifacts_truncated","retained_artifacts","retained_artifact_characters"],"additionalProperties":false,"properties":{"ordering":{"const":"occurred_at"},"artifacts_truncated":{"type":"boolean"},"retained_artifacts":{"type":"integer","minimum":0},"retained_artifact_characters":{"type":"integer","minimum":0}}},
        "session_state":{"type":"object","required":["session_id"],"additionalProperties":false,"properties":{"session_id":{"type":"string","minLength":1}}},"offer_context":{"type":"object","additionalProperties":false,"properties":{"offer_version":{"type":"string","minLength":1}}},"customer_state":{"type":"object","additionalProperties":false},"commercial_state":{"type":"object","additionalProperties":false,"properties":{"checkout_sent":{"type":"boolean"},"valid_purchase_confirmation":{"type":"boolean"}}},"metadata":{"type":"object","required":["channel"],"additionalProperties":false,"properties":{"channel":{"const":"whatsapp"},"campaign":{"enum":["standard","glp1_validation"]}}},"authoritative_context":{"type":"object","additionalProperties":false},"informational_context":{"type":"object","required":["knowledge"],"properties":{"knowledge":{"type":"array","maxItems":0,"items":{"$ref":"#/$defs/retrievedKnowledge"}}},"additionalProperties":false}
      }
    },
    "ConversationArtifact": {"$ref":"#/$defs/conversationArtifact"},
    "ConversationArtifactRecord": {"type":"object","required":["artifact","lineage"],"additionalProperties":false,"properties":{"artifact":{"$ref":"#/$defs/conversationArtifact"},"lineage":{"type":"array","items":{"type":"object","required":["artifact_id","source_artifact_id","position"],"additionalProperties":false,"properties":{"artifact_id":{"type":"string","pattern":"^ca-[A-Za-z0-9._-]+$"},"source_artifact_id":{"type":"string","pattern":"^ca-[A-Za-z0-9._-]+$"},"position":{"type":"integer","minimum":1}}}}},"allOf":[{"if":{"properties":{"artifact":{"properties":{"generation_operation":{"const":"draft"}}}}},"then":{"properties":{"lineage":{"maxItems":0}}}},{"if":{"properties":{"artifact":{"properties":{"generation_operation":{"enum":["transform","summarize"]}}}}},"then":{"properties":{"lineage":{"minItems":1}}}}]},
    "Obligation": {"$ref":"#/$defs/obligation"},
    "ResolvedObligation": {"$ref":"#/$defs/resolvedObligation"},
    "SemanticGuidanceGate": {"$ref":"#/$defs/semanticGuidanceGate"},
    "AuthorizedAction": {"$ref":"#/$defs/authorizedAction"},
    "ResponsePlan": {
      "type":"object", "required":["contract_version","context_id","locale","obligation_ids","required_coverage","canonical_facts","policy_outcomes","permitted_guidance","conversational_generation","commercial_semantics","bounded_uncertainties","clarification_requirements","deferred_obligations","authorized_actions","prohibited_claims","prohibited_actions","question_budget","completion_requirement"], "additionalProperties":false,
      "properties": {
        "contract_version":{"const":"2.0"}, "context_id":{"type":"string","minLength":1}, "locale":{"const":"es-MX"},
        "obligation_ids":{"type":"array","items":{"type":"string","pattern":"^o-[A-Za-z0-9._-]+$"},"uniqueItems":true},
        "required_coverage":{"type":"array","items":{"type":"object","required":["obligation_id","handling"],"additionalProperties":false,"properties":{"obligation_id":{"type":"string","pattern":"^o-[A-Za-z0-9._-]+$"},"handling":{"enum":["express_fact","express_policy","express_guidance","express_uncertainty","request_clarification","withhold_safety","withhold_indeterminate","commercial_handling","conversational_handling","support_unresolved","social_acknowledgement","deferred_practical_guidance","resolution_unavailable"]}}}},
