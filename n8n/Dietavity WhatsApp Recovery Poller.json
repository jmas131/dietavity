      "name": "Resume Verified WhatsApp Requests",
      "notes": "Ticket 28A wake-up only. The canonical messages ledger remains the queue and Claim Next Session Inbound preserves Ticket 17 ordering."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT message.session_id\nFROM public.messages AS message\nJOIN public.users AS app_user ON app_user.whatsapp_id = message.session_id\nWHERE message.direction = 'inbound'\n  AND message.processing_order IS NOT NULL\n  AND message.processing_completed_at IS NULL\n  AND message.metadata->>'identity_verification_purpose' = 'link_whatsapp'\n  AND message.metadata->>'identity_verification_state' = 'verified'\nORDER BY message.session_id;",
        "options": {}
      },
