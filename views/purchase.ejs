  <script id="purchase-checkout-script">
    (function () {
      var primaryButton = document.getElementById('purchase-button');
      var errorMessage = document.getElementById('purchase-error');
      var buttons = typeof document.querySelectorAll === 'function' ? Array.prototype.slice.call(document.querySelectorAll('.checkout-button')) : [primaryButton];
      var originalLabels = buttons.map(function (button) { return button.textContent; });
      var checkoutPending = false;
      async function startCheckout() {
        if (checkoutPending) return;
        checkoutPending = true;
        buttons.forEach(function (button) { button.disabled = true; button.textContent = 'Preparando tu pago...'; });
        errorMessage.hidden = true;
        errorMessage.textContent = '';
        if (typeof gtag === 'function') gtag('event', 'purchase_cta_click');
        if (typeof window.fbq === 'function') {
          try { window.fbq('track', 'InitiateCheckout', { content_name: '28-Day Program', value: 149, currency: 'MXN' }); }
          catch (trackingError) { /* Tracking must never interrupt Checkout creation. */ }
        }
        try {
          var response = await fetch('/api/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: '{}' });
          var result = await response.json();
          if (!response.ok || typeof result.checkout_url !== 'string' || !/^https:\/\/checkout\.stripe\.com\//.test(result.checkout_url)) throw new Error('CHECKOUT_UNAVAILABLE');
          window.location.assign(result.checkout_url);
        } catch (error) {
          errorMessage.textContent = 'No pudimos iniciar el pago. Intenta de nuevo.';
          errorMessage.hidden = false;
          buttons.forEach(function (button, index) { button.disabled = false; button.textContent = originalLabels[index]; });
          checkoutPending = false;
        }
      }
      buttons.forEach(function (button) { button.addEventListener('click', startCheckout); });
    })();
  </script>
