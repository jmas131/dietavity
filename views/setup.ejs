<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>Personaliza tu programa | Dietavity</title>

  <meta
    name="description"
    content="Personaliza tu programa de alimentación Dietavity."
  >

  <meta
    name="robots"
    content="noindex, nofollow"
  >

  <meta
    name="theme-color"
    content="#F5F1E8"
  >

  <!-- Icon -->

  <link
    rel="icon"
    href="/images/dietavity-favicon-96x96.png"
    type="image/png"
  >

  <!-- Google Fonts -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <!-- CSS -->

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  >

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

</head>

<body class="bg-light">

<%

const months = [

  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre"

];

const currentYear =
  new Date().getFullYear();

%>

<main class="container py-5">

  <!-- HEADER -->

  <header class="text-center mb-5">

    <img
      src="/images/dietavity-logo.webp"
      alt="Dietavity"
      class="img-fluid mb-4"
      style="max-width:180px;"
    >

    <h1 class="fw-bold mb-3">

      Personaliza tu programa

    </h1>

    <p
      class="lead text-muted mx-auto"
      style="max-width:650px;"
    >

      Responder estas preguntas nos ayudará a crear un programa adaptado a ti.

    </p>

  </header>

  <!-- FORM CARD -->

  <div class="card border-0 shadow-sm rounded-4 setup-card">

    <div class="card-body p-4 p-lg-5">

      <form
        id="profile-form"
        method="POST"
        action="/setup/<%= user.portal_token %>"
      >

        <!-- ===================================================== -->
        <!-- SOBRE TI -->
        <!-- ===================================================== -->

        <fieldset class="setup-section">

          <legend class="h4 fw-bold mb-4">

            Sobre ti

          </legend>

          <hr class="my-5">

          <div class="row g-4">

            <!-- Name -->

            <div class="col-12">

              <label
                for="name"
                class="form-label"
              >

                Nombre

              </label>

              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                value="<%= user.name || '' %>"
                autocomplete="name"
                maxlength="100"
                required
                autofocus
              >

            </div>

            <!-- Birth Month -->

            <div class="col-md-6">

              <label
                for="birth_month"
                class="form-label"
              >

                Mes de nacimiento

              </label>

              <select
                id="birth_month"
                name="birth_month"
                class="form-select"
                required
              >

                <option value="">
                  Selecciona un mes
                </option>

                <% months.forEach((month, index) => { %>

                  <option
                    value="<%= index + 1 %>"
                    <%= profile?.birth_month === index + 1 ? 'selected' : '' %>
                  >
                    <%= month %>
                  </option>

                <% }) %>

              </select>
            </div>

            <!-- Birth Year -->

            <div class="col-md-6">

              <label
                for="birth_year"
                class="form-label"
              >

                Año de nacimiento

              </label>

              <select
                id="birth_year"
                name="birth_year"
                class="form-select"
                required
              >

                <option value="">
                  Selecciona un año
                </option>

                <% for (let year = currentYear; year >= 1900; year--) { %>

                  <option
                    value="<%= year %>"
                    <%= profile?.birth_year === year ? 'selected' : '' %>
                  >
                    <%= year %>
                  </option>

                <% } %>

              </select>

            </div>

            <!-- Height -->

            <div class="col-md-6">

              <label
                for="height_cm"
                class="form-label"
              >

                Estatura (cm)

              </label>

              <input
                type="number"
                id="height_cm"
                name="height_cm"
                class="form-control"
                min="100"
                max="250"
                step="1"
                inputmode="numeric"
                placeholder="160"
                value="<%= profile?.height_cm || '' %>"
                required
              >

            </div>

            <!-- Weight -->

            <div class="col-md-6">

              <label
                for="weight_kg"
                class="form-label"
              >

                Peso (kg)

              </label>

              <input
                type="number"
                id="weight_kg"
                name="weight_kg"
                class="form-control"
                min="30"
                max="300"
                step="0.1"
                inputmode="decimal"
                placeholder="60"
                value="<%= profile?.weight_kg || '' %>"
                required
              >

            </div>

          </div>

        </fieldset>

        <!-- ===================================================== -->
        <!-- TU ALIMENTACIÓN -->
        <!-- ===================================================== -->

        <fieldset class="setup-section">

          <legend class="h4 fw-bold mt-5 mb-4">

            Tu alimentación

          </legend>

          <hr class="my-5">

          <!-- Eating Style -->

          <div class="mb-5">

            <label class="form-label fw-semibold d-block mb-3">

              ¿Sigues alguna dieta?

            </label>

            <div class="row g-3">

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="radio"
                    name="eating_style"
                    id="omnivore"
                    value="omnivore"
                    <%= profile?.eating_style === 'omnivore' ? 'checked' : '' %>
                    required
                  >

                  <label
                    class="form-check-label"
                    for="omnivore"
                  >
                    Como de todo
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="radio"
                    name="eating_style"
                    id="vegetarian"
                    value="vegetarian"
                    <%= profile?.eating_style === 'vegetarian' ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="vegetarian"
                  >
                    Vegetariana
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="radio"
                    name="eating_style"
                    id="vegan"
                    value="vegan"
                    <%= profile?.eating_style === 'vegan' ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="vegan"
                  >
                    Vegana
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="radio"
                    name="eating_style"
                    id="pescatarian"
                    value="pescatarian"
                    <%= profile?.eating_style === 'pescatarian' ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="pescatarian"
                  >
                    Pescetariana
                  </label>

                </div>

              </div>

            </div>

          </div>

          <!-- Medical Conditions -->

          <div class="mb-5">

            <label class="form-label fw-semibold d-block mb-3">

              ¿Tienes alguna condición médica?

            </label>

            <div class="row g-3">

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="hypertension"
                    name="medical_conditions"
                    value="hypertension"
                    <%= profile?.medical_conditions?.includes('hypertension') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="hypertension"
                  >
                    Hipertensión
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="high_cholesterol"
                    name="medical_conditions"
                    value="high_cholesterol"
                    <%= profile?.medical_conditions?.includes('high_cholesterol') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="high_cholesterol"
                  >
                    Colesterol alto
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="fatty_liver"
                    name="medical_conditions"
                    value="fatty_liver"
                    <%= profile?.medical_conditions?.includes('fatty_liver') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="fatty_liver"
                  >
                    Hígado graso
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="diabetes"
                    name="medical_conditions"
                    value="diabetes"
                    <%= profile?.medical_conditions?.includes('diabetes') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="diabetes"
                  >
                    Diabetes
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="pcos"
                    name="medical_conditions"
                    value="pcos"
                    <%= profile?.medical_conditions?.includes('pcos') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="pcos"
                  >
                    SOP (Síndrome de ovario poliquístico)
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="hypothyroidism"
                    name="medical_conditions"
                    value="hypothyroidism"
                    <%= profile?.medical_conditions?.includes('hypothyroidism') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="hypothyroidism"
                  >
                    Hipotiroidismo
                  </label>

                </div>

              </div>

            </div>

            <div class="mt-3">

              <label
                for="medical_conditions_other"
                class="form-label"
              >

                Otra condición médica

              </label>

              <input
                type="text"
                id="medical_conditions_other"
                name="medical_conditions_other"
                class="form-control"
                maxlength="100"
                placeholder="Escribe aquí"
              >

            </div>

          </div>

          <!-- Allergies -->

          <div class="mb-5">

            <label class="form-label fw-semibold d-block mb-3">

              ¿Tienes alguna alergia alimentaria?

            </label>

            <div class="row g-3">

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="dairy"
                    name="allergies"
                    value="dairy"
                    <%= profile?.allergies?.includes('dairy') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="dairy"
                  >
                    Lácteos
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="eggs"
                    name="allergies"
                    value="eggs"
                    <%= profile?.allergies?.includes('eggs') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="eggs"
                  >
                    Huevo
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="gluten"
                    name="allergies"
                    value="gluten"
                    <%= profile?.allergies?.includes('gluten') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="gluten"
                  >
                    Gluten
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="shellfish"
                    name="allergies"
                    value="shellfish"
                    <%= profile?.allergies?.includes('shellfish') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="shellfish"
                  >
                    Mariscos
                  </label>

                </div>

              </div>

              <div class="col-md-6">

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="tree_nuts"
                    name="allergies"
                    value="tree_nuts"
                    <%= profile?.allergies?.includes('tree_nuts') ? 'checked' : '' %>
                  >

                  <label
                    class="form-check-label"
                    for="tree_nuts"
                  >
                    Nueces y cacahuates
                  </label>

                </div>

              </div>

            </div>

            <div class="mt-3">

              <label
                for="allergies_other"
                class="form-label"
              >

                Otra alergia

              </label>

              <input
                type="text"
                id="allergies_other"
                name="allergies_other"
                class="form-control"
                maxlength="100"
                placeholder="Escribe aquí"
              >

            </div>

          </div>

          <!-- Foods to Avoid -->

          <div>

            <label
              for="foods_to_avoid"
              class="form-label fw-semibold"
            >

              ¿Hay alimentos que prefieres evitar?

            </label>

            <input
              type="text"
              id="foods_to_avoid"
              name="foods_to_avoid"
              class="form-control"
              maxlength="250"
              placeholder="Ejemplo: hígado, aceitunas, cilantro"
              value="<%= profile?.foods_to_avoid?.join(', ') || '' %>"
            >

            <div class="form-text">

              Sepáralos con comas.

            </div>

          </div>

        </fieldset>

        <!-- ===================================================== -->
        <!-- INFORMACIÓN ADICIONAL -->
        <!-- ===================================================== -->

        <fieldset class="setup-section">

          <legend class="h4 fw-bold mt-5 mb-4">

            Información adicional

          </legend>

          <hr class="my-5">

          <label
            for="notes"
            class="form-label"
          >

            ¿Hay algo más que debamos saber para crear tu programa?

          </label>

          <textarea
            id="notes"
            name="notes"
            class="form-control"
            rows="5"
            maxlength="500"
            placeholder="Trabajo de noche&#10;No tengo horno&#10;Estoy embarazada"
          ><%= profile?.notes || '' %></textarea>

        </fieldset>

        <!-- ===================================================== -->
        <!-- SUBMIT -->
        <!-- ===================================================== -->

        <div class="text-center pt-2">

          <p class="text-muted mb-4">

            Solo tardaremos unos segundos en crear tu programa.

          </p>

          <p class="small text-muted mx-auto mb-4" style="max-width: 620px;">

            Antes de enviar tu información, consulta nuestros
            <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer">Términos y Condiciones</a>
            y el
            <a href="/aviso-de-privacidad" target="_blank" rel="noopener noreferrer">Aviso de Privacidad</a>,
            que explica el tratamiento de datos personales y de salud.

          </p>

          <div class="form-check text-start mx-auto mb-4" style="max-width: 620px;">
            <input
              class="form-check-input"
              type="checkbox"
              value="true"
              id="sensitive-data-consent"
              name="sensitive_data_consent"
              required
            >
            <label class="form-check-label" for="sensitive-data-consent">
              Consiento expresamente el tratamiento de los datos personales sensibles que proporcione, incluidos datos de salud como alergias y condiciones médicas, para personalizar mi programa Dietavity de acuerdo con el
              <a href="/aviso-de-privacidad" target="_blank" rel="noopener noreferrer">Aviso de Privacidad</a>.
            </label>
          </div>

          <button
            type="submit"
            id="submit-button"
            class="btn btn-success btn-lg px-5 dietavity-button"
          >

            Crear mi programa personalizado

          </button>

        </div>

      </form>

    </div>

  </div>

</main>

<footer class="site-footer text-center small text-muted container pb-5">
  <nav aria-label="Enlaces legales">
    <a href="/terminos-y-condiciones">Términos y Condiciones</a>
    <a href="/aviso-de-privacidad">Aviso de Privacidad</a>
  </nav>
</footer>

<script src="/js/setup.js"></script>

</body>

</html>