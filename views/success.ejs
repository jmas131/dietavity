<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pago confirmado | Dietavity</title>
  <meta name="description" content="Tu pago de Dietavity fue confirmado. Completa tu perfil para preparar tu programa personalizado de 28 días.">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <meta name="theme-color" content="#F5F1E8">
  <% if (paymentPending) { %>
    <meta http-equiv="refresh" content="3">
  <% } %>

  <% if (purchaseVerified && typeof metaPixelId === 'string' && metaPixelId) { %>
    <script
      id="meta-pixel-loader"
      src="/js/meta-pixel.js"
      data-pixel-id="<%= metaPixelId %>"
      data-page-event="Purchase"
    ></script>
  <% } else if (!paymentPending && typeof metaPixelId === 'string' && metaPixelId) { %>
    <script
      id="meta-pixel-loader"
      src="/js/meta-pixel.js"
      data-pixel-id="<%= metaPixelId %>"
    ></script>
  <% } %>

  <link rel="icon" href="/images/dietavity-favicon-96x96.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">
  <main class="container py-5">
    <section class="status-card text-center mx-auto">
      <img
        src="/images/dietavity-logo.webp"
        alt="Dietavity"
        class="img-fluid mb-4"
        style="max-width: 180px;"
      >
      <% if (paymentPending) { %>
        <h1 class="fw-bold mb-3">Estamos confirmando tu pago</h1>
        <p class="lead mb-3">
          En unos momentos podrás completar tu perfil y preparar tu programa personalizado de 28 días.
        </p>
        <p class="text-muted mb-4">
          Esta página se actualizará automáticamente.
        </p>
      <% } else if (purchaseVerified) { %>
        <h1 class="fw-bold mb-3">🎉 ¡Pago confirmado!</h1>
        <p class="lead mb-3">
          Ahora completa tu perfil para preparar tu programa personalizado de 28 días.
        </p>
        <p class="text-muted mb-4">
          Te enviaremos por WhatsApp tu enlace seguro de configuración y acceso al portal Dietavity.
        </p>
        <% if (setupPath) { %>
          <a href="<%= setupPath %>" class="btn btn-success btn-lg px-4 dietavity-button">
            Personalizar mi programa
          </a>
        <% } else { %>
          <a href="https://wa.me/18158698400" class="btn btn-success btn-lg px-4 dietavity-button">
            Volver a WhatsApp
          </a>
        <% } %>
      <% } else { %>
        <h1 class="fw-bold mb-3">🎉 ¡Pago confirmado!</h1>
        <p class="lead mb-3">
          Ahora completa tu perfil para preparar tu programa personalizado de 28 días.
        </p>
        <p class="text-muted mb-4">
          Te enviaremos por WhatsApp tu enlace seguro de configuración y acceso al portal Dietavity.
        </p>
        <a href="https://wa.me/18158698400" class="btn btn-success btn-lg px-4 dietavity-button">
          Volver a WhatsApp
        </a>
      <% } %>
    </section>

    <footer class="site-footer text-center small text-muted">
      <nav aria-label="Enlaces legales y de servicio">
        <a href="/">Inicio</a>
        <a href="/terminos-y-condiciones">Términos y Condiciones</a>
        <a href="/aviso-de-privacidad">Aviso de Privacidad</a>
      </nav>
    </footer>
  </main>
  <% if (purchaseVerified && setupPath) { %>
    <script>
      window.setTimeout(function () {
        window.location.assign(<%- JSON.stringify(setupPath) %>);
      }, 1200);
    </script>
  <% } %>
</body>

</html>
